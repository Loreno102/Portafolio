---
import { Image } from 'astro:assets';
import avatar from '../assets/avatar.webp';
import { t, type Lang } from '../i18n/ui';
import { stack } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
---

<section class="section about wrap" id="sobre-mi">
  <figure class="id rv">
    <div class="id-top mono">
      <span>{s.binAbout} LRA-01</span>
      <span class="id-rec"><i></i>Live</span>
    </div>
    <div class="id-photo">
      <Image src={avatar} alt={lang === 'es' ? 'Avatar ilustrado de Lorena Rojas Arango' : 'Illustrated avatar of Lorena Rojas Arango'} widths={[360, 560, 760]} sizes="(max-width: 860px) 80vw, 380px" loading="lazy" />
      <span class="c tl"></span><span class="c tr"></span><span class="c bl"></span><span class="c br"></span>
    </div>
    <figcaption class="mono id-cap">
      <span>Lorena Rojas Arango</span>
      <span>Medellín · 2026</span>
    </figcaption>
  </figure>

  <div class="about-text">
    <p class="bin mono">{s.binAbout}</p>
    <h2 class="display h2 rv">{s.aboutTitle}</h2>
    <p class="about-p rv">{s.aboutP1}</p>
    <p class="about-p rv">{s.aboutP2}</p>

    <dl class="facts">
      <div><dt class="mono">{s.factStudy}</dt><dd>{s.factStudyV}</dd></div>
      <div><dt class="mono">{s.factBase}</dt><dd>{s.factBaseV}</dd></div>
      <div><dt class="mono">{s.factLang}</dt><dd>{s.factLangV}</dd></div>
      <div><dt class="mono">{s.stack}</dt><dd class="stack-list">{stack.map((x) => <span class="chip">{x}</span>)}</dd></div>
    </dl>
  </div>
</section>

<style>
  .about {
    display: grid; grid-template-columns: minmax(260px, 380px) minmax(0, 1fr);
    gap: clamp(30px, 6vw, 110px); align-items: start;
    border-top: 1px solid var(--line);
  }
  .id {
    margin: 0; padding: 12px; position: sticky; top: 100px;
    background: var(--bg-2); border: 1px solid var(--line); border-radius: var(--radius);
    transform: rotate(-2deg);
  }
  .id-top, .id-cap { display: flex; justify-content: space-between; gap: 8px; color: var(--fg-2); font-size: 11px; padding: 2px 4px 10px; }
  .id-cap { padding: 10px 4px 2px; }
  .id-rec { display: inline-flex; align-items: center; gap: 6px; color: var(--rec); }
  .id-rec i { width: 7px; height: 7px; border-radius: 50%; background: var(--rec); }
  .id-photo { position: relative; border-radius: 12px; overflow: hidden; aspect-ratio: 4 / 5; background: var(--bg-3); }
  .id-photo img { width: 100%; height: 100%; object-fit: cover; }
  .c { position: absolute; width: 22px; height: 22px; border: 2px solid #0c0c0d; }
  .tl { left: 12px; top: 12px; border-right: 0; border-bottom: 0; }
  .tr { right: 12px; top: 12px; border-left: 0; border-bottom: 0; }
  .bl { left: 12px; bottom: 12px; border-right: 0; border-top: 0; }
  .br { right: 12px; bottom: 12px; border-left: 0; border-top: 0; }

  .about-p { max-width: 54ch; font-size: clamp(18px, 1.4vw, 22px); margin: 26px 0 0; }
  .about-p + .about-p { color: var(--fg-2); margin-top: 16px; }

  .facts { margin: 44px 0 0; display: grid; }
  .facts div { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; padding-block: 16px; border-top: 1px solid var(--line); }
  .facts dt { color: var(--fg-2); padding-top: 3px; }
  .facts dd { margin: 0; }
  .stack-list { display: flex; flex-wrap: wrap; gap: 6px; }

  @media (max-width: 860px) {
    .about { grid-template-columns: 1fr; }
    .id { position: relative; top: auto; width: min(320px, 82%); }
    .facts div { grid-template-columns: 1fr; gap: 4px; }
  }
</style>
