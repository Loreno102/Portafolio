---
import { t, type Lang } from '../i18n/ui';
import { process } from '../data/projects';
interface Props { lang: Lang }
const { lang } = Astro.props;
const s = t(lang);
const tracks = ['V3', 'V2', 'V1', 'A1', 'OUT'];
const ruler = Array.from({ length: 7 }, (_, i) => `00:00:${String(i * 5).padStart(2, '0')}:00`);
---

<section class="section process" id="proceso">
  <div class="wrap">
    <p class="bin mono">{s.binProcess}</p>
    <h2 class="display h2 rv">{s.processTitle}</h2>
    <p class="lead rv">{s.processIntro}</p>
  </div>

  <div class="tl wrap" style={`--n:${process.length}`}>
    <div class="tl-board">
      <div class="tl-ruler mono" aria-hidden="true">
        <span class="tl-label"></span>
        <div class="tl-ticks">{ruler.map((r) => <span>{r}</span>)}</div>
      </div>
      {tracks.map((tr) => (
        <div class="tl-track" aria-hidden="true">
          <span class="tl-label mono">{tr}</span>
          <div class="tl-lane">
            {process.map((p, i) => p.track === tr && (
              <span class="tl-clip mono" style={`--c:${i}`} data-step={i}>
                {String(i + 1).padStart(2, '0')} {p.title[lang]}
              </span>
            ))}
          </div>
        </div>
      ))}
      <span class="tl-head" aria-hidden="true"><i class="mono">00:00:00:00</i></span>
    </div>

    <ol class="tl-steps">
      {process.map((p, i) => (
        <li class="rv" data-step={i}>
          <span class="mono">{String(i + 1).padStart(2, '0')} · {p.track}</span>
          <h3>{p.title[lang]}</h3>
          <p>{p.text[lang]}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .process { border-top: 1px solid var(--line); }
  .tl { margin-top: clamp(40px, 6vw, 80px); }

  .tl-board {
    --label: 56px;
    position: relative;
    border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--bg-2); padding: 10px 14px 14px; overflow: hidden;
  }
  .tl-ruler, .tl-track { display: grid; grid-template-columns: var(--label) 1fr; align-items: center; }
  .tl-ruler { height: 30px; color: var(--fg-2); font-size: 10px; border-bottom: 1px solid var(--line); }
  .tl-ticks { display: flex; justify-content: space-between; }
  .tl-track { height: 46px; border-bottom: 1px dashed var(--line); }
  .tl-track:last-of-type { border-bottom: 0; }
  .tl-label { color: var(--fg-2); font-size: 11px; }
  .tl-lane { position: relative; height: 100%; }
  .tl-clip {
    position: absolute; top: 7px; bottom: 7px;
    left: calc(var(--c) * 100% / var(--n)); width: calc(100% / var(--n) - 6px);
    display: flex; align-items: center; padding: 0 10px;
    border-radius: 8px; font-size: 11px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    background: var(--bg-3); color: var(--fg-2);
    transition: background-color .3s, color .3s;
  }
  .tl-clip.is-on { background: var(--lime); color: #0c0c0d; }
  :global(:root[data-theme='light']) .tl-clip.is-on { background: var(--blue); color: #f4f3ff; }

  .tl-head {
    --p: 0;
    position: absolute; top: 10px; bottom: 14px;
    left: calc(14px + var(--label) + (100% - 28px - var(--label)) * var(--p));
    width: 2px; background: var(--rec); pointer-events: none;
  }
  .tl-head i {
    position: absolute; top: 0; left: 50%; transform: translateX(-50%);
    padding: 3px 6px; border-radius: 4px; background: var(--rec); color: #fff;
    font-style: normal; font-size: 10px; white-space: nowrap;
  }

  .tl-steps {
    list-style: none; margin: 30px 0 0; padding: 0;
    display: grid; grid-template-columns: repeat(var(--n), minmax(0, 1fr)); gap: 20px;
  }
  .tl-steps li { padding-top: 14px; border-top: 2px solid var(--line); transition: border-color .3s; }
  .tl-steps li.is-on { border-color: var(--accent); }
  .tl-steps span { color: var(--fg-2); }
  .tl-steps h3 {
    font-family: var(--font-display); font-weight: 700; font-variation-settings: 'wdth' 80;
    font-size: clamp(20px, 1.8vw, 28px); line-height: 1; margin: 10px 0 8px; text-transform: uppercase;
  }
  .tl-steps p { margin: 0; color: var(--fg-2); font-size: 15px; }

  @media (max-width: 900px) {
    .tl-board { display: none; }
    .tl-steps { grid-template-columns: 1fr; gap: 0; }
    .tl-steps li { display: grid; grid-template-columns: 90px 1fr; column-gap: 16px; padding-block: 18px; }
    .tl-steps li > * { grid-column: 2; }
    .tl-steps li span { grid-column: 1; grid-row: 1 / 3; }
    .tl-steps h3 { margin-top: 0; }
  }
</style>

<script>
  // El cabezal rojo avanza con el scroll y va encendiendo cada paso
  const section = document.querySelector<HTMLElement>('.process');
  if (section) {
    const head = section.querySelector<HTMLElement>('.tl-head')!;
    const label = head.querySelector('i')!;
    const clips = section.querySelectorAll<HTMLElement>('.tl-clip');
    const steps = section.querySelectorAll<HTMLElement>('.tl-steps li');
    const n = steps.length;
    const pad = (v: number) => String(v).padStart(2, '0');

    const update = () => {
      const r = section.getBoundingClientRect();
      const p = Math.min(1, Math.max(0, (innerHeight * 0.75 - r.top) / (r.height * 0.85)));
      head.style.setProperty('--p', String(p));
      const sec = p * 30;
      label.textContent = `00:00:${pad(Math.floor(sec))}:${pad(Math.floor((sec % 1) * 24))}`;
      const active = Math.min(n - 1, Math.floor(p * n));
      clips.forEach((c) => c.classList.toggle('is-on', Number(c.dataset.step) <= active && p > 0));
      steps.forEach((s, i) => s.classList.toggle('is-on', i <= active && p > 0));
    };
    addEventListener('scroll', () => requestAnimationFrame(update), { passive: true });
    update();
  }
</script>
