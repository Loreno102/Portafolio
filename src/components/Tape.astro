---
interface Props { items: readonly string[]; variant?: 'lime' | 'blue'; reverse?: boolean }
const { items, variant = 'lime', reverse = false } = Astro.props;
// Se repite dos veces para que el loop sea continuo
const loop = [...items, ...items, ...items, ...items];
---

<div class:list={['tape', { 'is-blue': variant === 'blue', 'is-rev': reverse }]} aria-hidden="true">
  <div class="tape-track">
    {loop.map((w) => (
      <span class="tape-item">
        {w}
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 0l2.4 9.6L24 12l-9.6 2.4L12 24l-2.4-9.6L0 12l9.6-2.4z"/></svg>
      </span>
    ))}
  </div>
</div>
